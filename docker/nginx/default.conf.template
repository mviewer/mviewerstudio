server {
    listen       80;
    server_name  ${NGINX_HOST};

    location = /mviewer {
        return 302 /mviewer/$is_args$args;
    }

    location /mviewer/ {
        proxy_pass http://mviewer/;
    }

    location /apps/ {
        alias /usr/share/nginx/html/apps/;
    }

    location /${MVIEWERSTUDIO_URL_PATH_PREFIX}/ {
        proxy_pass http://mviewerstudio:8000/${MVIEWERSTUDIO_URL_PATH_PREFIX}/;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        # Keycloak/oauth2-proxy mode:
        # Use MVIEWERSTUDIO_AUTH_TYPE=keycloak behind oauth2-proxy.
        # See the /keycloak submodule nginx template for the complete
        # auth_request configuration. Roles/groups are enforced by
        # Keycloak/oauth2-proxy, not by mviewerstudio.

        # geOrchestra mode:
        # Use MVIEWERSTUDIO_AUTH_TYPE=georchestra to adapt geOrchestra's
        # historical security-proxy headers to the normalized OAuth2 identity.
        #proxy_set_header sec-username "testadmin";
        #proxy_set_header sec-roles "ROLE_ADMINISTRATOR;ROLE_MVIEWER_ADMIN";
        #proxy_set_header sec-org "geobretagne";
    }

    location / {
        server_name_in_redirect off;
        return 302 /${MVIEWERSTUDIO_URL_PATH_PREFIX}/;
    }
}
